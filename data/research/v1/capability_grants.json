{
  "schema_version": 1,
  "catalog_id": "stellar_continuum.public.adaptive_research_possibility_graph.v1",
  "purpose": "Defines maturity-stage exceptions and non-capability grants. A research node's own `capabilities` are granted at Mature by default; this file avoids duplicating those outputs and stores only earlier capability timing, mutable civilization-trait grants, and research-capacity stage grants.",
  "default_rules": {
    "node_capabilities_grant_at_stage": "mature",
    "implementation_markers_and_cross_lineage_capabilities_follow_same_default_stage": true,
    "node_override_can_grant_selected_capabilities_earlier": true,
    "trait_and_research_capacity_grants_must_be_explicit": true
  },
  "node_grant_overrides": {
    "prototype_warp_drive": {
      "early_capability_grants": {
        "at_stage": "demonstrated",
        "capabilities": ["experimental_interstellar_transit"]
      }
    },
    "synthetic_cognition": {
      "at_stage": "mature",
      "grant_civilization_traits": ["machine_cognition_present"]
    },
    "biofabrication": {
      "at_stage": "mature",
      "grant_civilization_traits": ["biological_fabrication_possible"]
    },
    "coordinated_research_networks": {
      "at_stage": "mature",
      "research_capacity_stage": "coordinated_research_networks"
    },
    "distributed_scientific_portfolios": {
      "at_stage": "mature",
      "research_capacity_stage": "distributed_scientific_portfolios"
    },
    "autonomous_research_portfolios": {
      "at_stage": "mature",
      "research_capacity_stage": "autonomous_research_portfolios"
    }
  },
  "rules": {
    "trait_grants_do_not_rewrite_species_biology": true,
    "civilization_traits_represent_acquired_capabilities_or_institutions": true,
    "population_scoped_capabilities_require_compatible_population_context": true,
    "granting_a_capability_does_not_reveal_all_technologies_that_can_produce_it": true,
    "foreign_or_secret_sources_may_grant_the_same_capability_without_being_listed_here": true
  }
}
