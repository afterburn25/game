{
  "schema_version": 1,
  "catalog_id": "stellar_continuum.public.adaptive_research_possibility_graph.v1",
  "purpose": "Defines ordinary public Research Pressure generation and decay. Pressure is sparse civilization state derived from real simulation conditions/events; it is not a hidden ranking catch-up mechanic.",
  "global_model": {
    "range": [0, 100],
    "stored_sparsely": true,
    "not_spendable": true,
    "does_not_directly_generate_rp": true,
    "event_driven_updates": true,
    "scheduled_metric_review": "quarterly_or_yearly_by_signal_class",
    "update_formula": "pressure approaches the strongest/current weighted condition target, event pulses add bounded urgency, and decay applies when sustaining signals disappear",
    "materialization_rule": "A civilization does not need an active record for a pressure at zero unless the pressure is already known/relevant to a visible field.",
    "no_rank_rubber_band": true,
    "no_year_unlocks": true
  },
  "rules": {
    "energy_shortage": {"metric_signals":["unserved_energy_fraction","energy_reserve_days_low"],"event_signals":["major_power_shortage"],"decay_per_year":12,"memory_floor":0},
    "grid_instability": {"metric_signals":["grid_failure_rate","power_quality_instability"],"event_signals":["regional_grid_collapse"],"decay_per_year":15,"memory_floor":0},
    "reactor_limits": {"metric_signals":["reactor_utilization_near_limit","power_mass_bottleneck"],"event_signals":["reactor_performance_failure"],"decay_per_year":8,"memory_floor":0},
    "launch_cost": {"metric_signals":["surface_to_orbit_cost_burden","launch_capacity_saturation"],"event_signals":["launch_bottleneck_delays_major_project"],"decay_per_year":6,"memory_floor":0},
    "orbital_growth": {"metric_signals":["orbital_population_fraction","orbital_industry_growth","orbital_asset_count_normalized"],"event_signals":["major_orbital_settlement_completed"],"decay_per_year":3,"memory_floor":0},
    "vacuum_industry": {"metric_signals":["vacuum_manufacturing_advantage_observed","low_gravity_resource_access"],"event_signals":["novel_vacuum_process_discovered"],"decay_per_year":4,"memory_floor":0},
    "resource_scarcity": {"metric_signals":["strategic_resource_deficit","reserve_days_low","import_dependency_risk"],"event_signals":["critical_resource_supply_cut"],"decay_per_year":7,"memory_floor":0},
    "asteroid_opportunity": {"metric_signals":["known_accessible_asteroid_value","asteroid_resource_advantage"],"event_signals":["high_value_asteroid_discovered"],"decay_per_year":4,"memory_floor":0},
    "industrial_bottleneck": {"metric_signals":["construction_queue_delay","industrial_capacity_saturation","manufacturing_shortfall"],"event_signals":["major_project_delayed_by_industry"],"decay_per_year":10,"memory_floor":0},
    "labor_shortage": {"metric_signals":["unfilled_labor_demand","critical_skill_shortage","dependency_ratio_pressure"],"event_signals":["labor_crisis"],"decay_per_year":8,"memory_floor":0},
    "long_duration_mission": {"metric_signals":["crew_mission_duration_relative_to_tolerance","remote_mission_demand"],"event_signals":["long_duration_mission_authorized"],"decay_per_year":4,"memory_floor":0},
    "life_support_losses": {"metric_signals":["life_support_failure_rate","consumable_loss_fraction"],"event_signals":["fatal_life_support_failure","settlement_life_support_crisis"],"decay_per_year":10,"memory_floor":0},
    "food_shortage": {"metric_signals":["food_deficit_fraction","food_reserve_days_low","food_import_dependency"],"event_signals":["famine_or_severe_rationing"],"decay_per_year":12,"memory_floor":0},
    "water_shortage": {"metric_signals":["water_deficit_fraction","water_reserve_days_low","water_recycling_loss"],"event_signals":["settlement_water_crisis"],"decay_per_year":12,"memory_floor":0},
    "radiation_exposure": {"metric_signals":["population_radiation_dose_excess","crew_radiation_dose_excess","radiation_related_health_burden"],"event_signals":["major_radiation_incident"],"decay_per_year":7,"memory_floor":0},
    "high_gravity_health": {"metric_signals":["high_g_population_health_burden","high_g_productivity_burden","high_g_developmental_burden"],"event_signals":["high_g_medical_crisis"],"decay_per_year":5,"memory_floor":0},
    "low_gravity_health": {"metric_signals":["low_g_population_health_burden","low_g_return_to_normal_g_burden","low_g_developmental_burden"],"event_signals":["low_g_medical_crisis"],"decay_per_year":5,"memory_floor":0},
    "extreme_temperature": {"metric_signals":["population_temperature_mismatch","habitat_thermal_cost_burden"],"event_signals":["thermal_habitat_failure"],"decay_per_year":6,"memory_floor":0},
    "high_pressure_environment": {"metric_signals":["population_pressure_mismatch","high_pressure_habitat_cost_burden"],"event_signals":["pressure_habitat_failure"],"decay_per_year":6,"memory_floor":0},
    "oceanic_environment": {"metric_signals":["ocean_world_settlement_opportunity","subsurface_ocean_resource_opportunity"],"event_signals":["major_oceanic_site_discovered"],"decay_per_year":4,"memory_floor":0},
    "colony_isolation": {"metric_signals":["settlement_resupply_interval","settlement_import_dependency","communication_or_transport_isolation"],"event_signals":["colony_cut_off"],"decay_per_year":5,"memory_floor":0},
    "supply_line_overstretch": {"metric_signals":["fleet_supply_route_burden","colony_supply_route_burden","logistics_capacity_utilization"],"event_signals":["operation_failed_for_supply_reason"],"decay_per_year":8,"memory_floor":0},
    "maintenance_failures": {"metric_signals":["equipment_failure_rate","deferred_maintenance_fraction","spare_part_shortfall"],"event_signals":["catastrophic_maintenance_failure"],"decay_per_year":10,"memory_floor":0},
    "transport_delay": {"metric_signals":["freight_delay_cost","passenger_delay_burden","critical_delivery_latency"],"event_signals":["critical_delivery_missed"],"decay_per_year":8,"memory_floor":0},
    "communication_delay": {"metric_signals":["command_latency_burden","economic_latency_burden","governance_latency_burden"],"event_signals":["latency_caused_major_failure"],"decay_per_year":4,"memory_floor":0},
    "sensor_blindness": {"metric_signals":["unknown_contact_fraction","tracking_uncertainty","unobserved_strategic_volume"],"event_signals":["surprise_contact_or_attack"],"decay_per_year":8,"memory_floor":0},
    "stealth_threat": {"metric_signals":["low_signature_contact_rate","unresolved_contact_loss_rate"],"event_signals":["stealth_attack_detected_late"],"decay_per_year":9,"memory_floor":0},
    "alien_signal": {"metric_signals":["unresolved_alien_signal_relevance"],"event_signals":["alien_signal_detected","alien_communication_received"],"decay_per_year":2,"memory_floor":5},
    "foreign_technology_observed": {"metric_signals":["observed_foreign_capability_gap","foreign_technology_novelty"],"event_signals":["new_foreign_capability_observed"],"decay_per_year":3,"memory_floor":0},
    "foreign_device_captured": {"metric_signals":["foreign_artifact_research_value_in_custody"],"event_signals":["foreign_device_acquired"],"decay_per_year":1,"memory_floor":5},
    "alien_biology_encountered": {"metric_signals":["alien_biology_research_value"],"event_signals":["alien_biology_first_encounter","new_alien_biosphere_sample"],"decay_per_year":2,"memory_floor":5},
    "enemy_speed_superiority": {"metric_signals":["observed_enemy_strategic_speed_advantage","failed_interception_due_to_speed","enemy_response_time_advantage"],"event_signals":["battle_or_operation_lost_to_enemy_mobility"],"decay_per_year":10,"memory_floor":0},
    "missile_threat": {"metric_signals":["incoming_missile_damage_share","missile_interception_failure_rate","enemy_standoff_weapon_prevalence"],"event_signals":["major_missile_attack"],"decay_per_year":12,"memory_floor":0},
    "armor_failure": {"metric_signals":["armor_penetration_rate","armor_defeat_damage_share"],"event_signals":["major_armor_failure"],"decay_per_year":12,"memory_floor":0},
    "weapon_ineffectiveness": {"metric_signals":["weapon_damage_below_expected","target_survival_against_current_weapons","failed_kill_probability"],"event_signals":["major_engagement_weapons_ineffective"],"decay_per_year":10,"memory_floor":0},
    "fleet_losses": {"metric_signals":["fleet_loss_rate","military_loss_fraction_of_capacity"],"event_signals":["major_fleet_defeat","fleet_destroyed"],"decay_per_year":8,"memory_floor":0},
    "command_disruption": {"metric_signals":["command_link_failure_rate","orders_latency_failure","command_node_loss_rate"],"event_signals":["major_command_network_disruption"],"decay_per_year":10,"memory_floor":0},
    "cyber_threat": {"metric_signals":["hostile_intrusion_rate","automation_compromise_risk","cyber_damage_share"],"event_signals":["major_cyberattack"],"decay_per_year":10,"memory_floor":0},
    "orbital_attack": {"metric_signals":["orbital_asset_threat_exposure","hostile_orbital_presence","planetary_orbit_defense_gap"],"event_signals":["orbital_bombardment","orbital_infrastructure_destroyed"],"decay_per_year":8,"memory_floor":0},
    "planetary_invasion": {"metric_signals":["planetary_invasion_risk","ground_force_readiness_gap","hostile_transport_presence"],"event_signals":["planetary_invasion_attempted","colony_occupied"],"decay_per_year":7,"memory_floor":0},
    "population_growth": {"metric_signals":["population_growth_rate","settlement_capacity_pressure"],"event_signals":["major_demographic_expansion"],"decay_per_year":3,"memory_floor":0},
    "habitat_crowding": {"metric_signals":["habitat_capacity_utilization","housing_shortfall","life_support_density_burden"],"event_signals":["habitat_overcapacity_crisis"],"decay_per_year":8,"memory_floor":0},
    "administrative_distance": {"metric_signals":["decision_latency_by_distance","regional_governance_load","center_periphery_coordination_cost"],"event_signals":["remote_governance_failure"],"decay_per_year":4,"memory_floor":0},
    "political_fragmentation": {"metric_signals":["regional_political_divergence","secession_support","institutional_conflict"],"event_signals":["major_constitutional_crisis","secession_attempt"],"decay_per_year":4,"memory_floor":0},
    "trade_growth": {"metric_signals":["trade_volume_growth","trade_partner_count","cross_system_trade_complexity"],"event_signals":["major_trade_route_opened"],"decay_per_year":3,"memory_floor":0},
    "archive_loss": {"metric_signals":["historical_record_loss_rate","knowledge_archive_fragility"],"event_signals":["major_archive_destroyed","civilizational_data_loss"],"decay_per_year":2,"memory_floor":5},
    "ecological_damage": {"metric_signals":["ecosystem_function_loss","biodiversity_loss","pollution_burden"],"event_signals":["ecological_disaster"],"decay_per_year":5,"memory_floor":0},
    "climate_instability": {"metric_signals":["climate_variability_damage","temperature_precipitation_instability","extreme_weather_burden"],"event_signals":["major_climate_disaster"],"decay_per_year":5,"memory_floor":0},
    "terraforming_need": {"metric_signals":["desired_world_environment_mismatch","habitat_cost_due_to_environment","colonization_demand_for_hostile_worlds"],"event_signals":["strategic_world_rejected_for_environment"],"decay_per_year":3,"memory_floor":0},
    "stellar_hazard": {"metric_signals":["stellar_weather_damage_risk","flare_cme_exposure","impact_hazard_risk"],"event_signals":["major_stellar_weather_event","impact_threat_detected"],"decay_per_year":5,"memory_floor":0},
    "fundamental_anomaly": {"metric_signals":["unexplained_observation_significance","repeatable_theory_violation"],"event_signals":["major_physical_anomaly_detected","experiment_violates_current_model"],"decay_per_year":1,"memory_floor":5},
    "scientific_curiosity": {"metric_signals":["unallocated_basic_science_capacity","scientific_institution_autonomy","open_question_density"],"event_signals":["major_theoretical_breakthrough","new_observatory_result"],"decay_per_year":2,"memory_floor":10},
    "automation_demand": {"metric_signals":["automatable_work_backlog","labor_shortage_for_routine_tasks","control_complexity"],"event_signals":["automation_bottleneck"],"decay_per_year":6,"memory_floor":0},
    "ai_safety_incident": {"metric_signals":["unsafe_ai_event_rate","automation_control_loss_risk"],"event_signals":["major_ai_safety_failure"],"decay_per_year":6,"memory_floor":0},
    "research_bottleneck": {"metric_signals":["investigable_project_backlog","lab_capacity_utilization","directed_program_slot_saturation"],"event_signals":["strategic_research_delayed_by_capacity"],"decay_per_year":8,"memory_floor":0},
    "disease_burden": {"metric_signals":["disease_morbidity","disease_mortality","health_system_load"],"event_signals":["epidemic_or_pandemic"],"decay_per_year":10,"memory_floor":0},
    "aging_population": {"metric_signals":["age_related_morbidity","dependency_ratio","healthy_lifespan_gap"],"event_signals":["aging_system_crisis"],"decay_per_year":3,"memory_floor":0},
    "gravity_divergence": {"metric_signals":["multi_gravity_population_fraction","cross_gravity_health_incompatibility","gravity_adapted_population_divergence"],"event_signals":["gravity_population_compatibility_crisis"],"decay_per_year":2,"memory_floor":0},
    "interstellar_distance": {"metric_signals":["reachable_target_travel_burden","unreachable_known_target_value","transit_time_strategic_cost"],"event_signals":["mission_abandoned_for_distance","high_value_distant_target_confirmed"],"decay_per_year":3,"memory_floor":0}
  },
  "implementation_guardrails": {
    "signals_are_normalized_by_owning_subsystem": true,
    "pressure_update_does_not_scan_technology_nodes": true,
    "pressure_to_candidate_index_is_static": true,
    "event_pulses_are_bounded": true,
    "historical_events_may_leave_small_memory_floor_only_where_configured": true,
    "ai_and_player_use_same_pressure_rules": true,
    "relative_enemy_signals_require_legitimate_observation": true,
    "unknown_enemy_stats_cannot_generate_exact_pressure": true
  }
}
